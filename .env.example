# OpenRouter API key
# Set the real value in the Vercel project environment variables.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Google sign-in + 10 daily recurring credits)
# Project URL / anon key: Supabase Dashboard -> Settings -> API
# Service role key: SERVER ONLY - never expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin for metadata, canonical tags, sitemap, and robots.
# Optional: defaults to https://www.qattan-ai.com (lib/site.ts). Set this to
# the deployment's own origin on preview/staging projects.
NEXT_PUBLIC_SITE_URL=
